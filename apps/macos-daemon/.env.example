# Copy to .env beside run.py. The foreground and background service load it at startup.
TYPESAFE_API_KEY=replace_with_your_typesafe_api_key

# Remote browser only. ChatGPT OAuth tokens stay in the protected state directory.
# Create a Cloudflare token with Browser Rendering - Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
